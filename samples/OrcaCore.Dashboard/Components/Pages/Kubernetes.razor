@page "/kubernetes"
@rendermode InteractiveServer
@using System.Text.Json
@using System.Text.Json.Serialization
@implements IAsyncDisposable
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>OrcaCore Kubernetes Sample</PageTitle>

<section class="dashboard-title">
    <div>
        <p class="eyebrow">Local Kubernetes</p>
        <h1>Workflow job scheduler</h1>
        @if (snapshot is not null)
        {
            <p class="timestamp">Snapshot @FormatTime(DateTimeOffset.Now)</p>
        }
    </div>
    <div class="toolbar" role="group" aria-label="Kubernetes sample actions">
        <button class="tool-button" @onclick="StartScheduledAsync" disabled="@busy">Scheduled job</button>
        <button class="tool-button" @onclick="StartDependencyAsync" disabled="@busy">Dependency workflow</button>
        <button class="tool-button primary" @onclick="StartDagAsync" disabled="@busy">DAG workflow</button>
        <button class="tool-button" @onclick="RefreshAsync" disabled="@busy">Refresh</button>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(loadError))
{
    <section class="panel">
        <div class="issue-list">
            <article class="issue issue-error">
                <div class="issue-head">
                    <span class="severity">Error</span>
                    <strong>Kubernetes sample request failed.</strong>
                    <time>@DateTimeOffset.Now.ToString("HH:mm:ss")</time>
                </div>
                <code>@loadError</code>
            </article>
        </div>
    </section>
}

@if (snapshot is null)
{
    <section class="empty-state">Loading Kubernetes sample state from API...</section>
}
else
{
    <section class="status-strip status-@(snapshot.KubectlAvailable ? "healthy" : "degraded")">
        <div>
            <span class="status-label">kubectl</span>
            <strong>@(snapshot.KubectlAvailable ? "Ready" : "Unavailable")</strong>
        </div>
        <div>
            <span class="status-label">Namespace</span>
            <strong>@snapshot.Namespace</strong>
        </div>
        <div>
            <span class="status-label">Schedule</span>
            <strong>@FormatDuration(snapshot.ScheduledInterval)</strong>
        </div>
        <div>
            <span class="status-label">Runs</span>
            <strong>@snapshot.Runs.Count</strong>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(snapshot.LastError))
    {
        <section class="panel">
            <div class="issue-list">
                <article class="issue issue-warning">
                    <div class="issue-head">
                        <span class="severity">Warning</span>
                        <strong>@snapshot.LastError</strong>
                        <time>@FormatTime(snapshot.LastSchedulerTick ?? DateTimeOffset.Now)</time>
                    </div>
                </article>
            </div>
        </section>
    }

    <section class="panel">
        <div class="panel-heading">
            <h2>Kubernetes runs</h2>
            <span>@snapshot.Runs.Count visible</span>
        </div>
        <div class="workflow-list">
            @foreach (var run in snapshot.Runs)
            {
                <article class="workflow">
                    <div class="workflow-summary">
                        <div>
                            <span class="severity issue-@Css(ToSeverity(run.Status))">@run.Status</span>
                            <strong>@run.Kind</strong>
                            <small>@run.Id</small>
                        </div>
                        <div>
                            <span>Jobs</span>
                            <strong>@run.Nodes.Count</strong>
                            <small>@run.Summary</small>
                        </div>
                        <div>
                            <span>Durable instance</span>
                            <strong>@ShortId(run.DurableInstanceId ?? "pending")</strong>
                            <small>@(run.Error ?? "No error")</small>
                        </div>
                    </div>

                    <div class="node-grid">
                        @foreach (var node in run.Nodes)
                        {
                            <div class="node-card node-@Css(node.Status)">
                                <div>
                                    <span>@node.Status</span>
                                    <strong>@node.Label</strong>
                                </div>
                                <time>@FormatDuration(TimeSpan.FromSeconds(node.DurationSeconds))</time>
                                <code>@node.Name</code>
                                @if (node.DependsOn.Count > 0)
                                {
                                    <small>@string.Join(", ", node.DependsOn.Select(ShortId))</small>
                                }
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    </section>
}

@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web)
    {
        Converters = { new JsonStringEnumConverter() }
    };

    private KubernetesSampleSnapshot? snapshot;
    private CancellationTokenSource? refreshCancellation;
    private bool busy;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync().ConfigureAwait(false);
        refreshCancellation = new CancellationTokenSource();
        _ = RefreshLoopAsync(refreshCancellation.Token);
    }

    public ValueTask DisposeAsync()
    {
        refreshCancellation?.Cancel();
        refreshCancellation?.Dispose();
        return ValueTask.CompletedTask;
    }

    private async Task RefreshLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
            while (await timer.WaitForNextTickAsync(cancellationToken).ConfigureAwait(false))
            {
                await InvokeAsync(RefreshAsync).ConfigureAwait(false);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private Task StartScheduledAsync()
    {
        return PostAsync("/api/kubernetes-sample/scheduled");
    }

    private Task StartDependencyAsync()
    {
        return PostAsync("/api/kubernetes-sample/dependency");
    }

    private Task StartDagAsync()
    {
        return PostAsync("/api/kubernetes-sample/dag");
    }

    private async Task PostAsync(string path)
    {
        busy = true;
        loadError = null;
        try
        {
            using var client = HttpClientFactory.CreateClient();
            using var response = await client.PostAsync(Navigation.ToAbsoluteUri(path), null).ConfigureAwait(false);
            response.EnsureSuccessStatusCode();
            snapshot = await response.Content.ReadFromJsonAsync<KubernetesSampleSnapshot>(
                JsonOptions,
                CancellationToken.None).ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RefreshAsync()
    {
        loadError = null;
        try
        {
            using var client = HttpClientFactory.CreateClient();
            snapshot = await client.GetFromJsonAsync<KubernetesSampleSnapshot>(
                Navigation.ToAbsoluteUri("/api/kubernetes-sample/snapshot"),
                JsonOptions,
                CancellationToken.None).ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
    }

    private static IssueSeverity ToSeverity(KubernetesRunStatus status)
    {
        return status switch
        {
            KubernetesRunStatus.Failed => IssueSeverity.Error,
            KubernetesRunStatus.Running => IssueSeverity.Warning,
            _ => IssueSeverity.Info
        };
    }

    private static string Css<T>(T value)
    {
        return value?.ToString()?.ToLowerInvariant() ?? "neutral";
    }

    private static string FormatTime(DateTimeOffset value)
    {
        return value.ToLocalTime().ToString("HH:mm:ss");
    }

    private static string FormatDuration(TimeSpan value)
    {
        if (value.TotalMinutes >= 1)
        {
            return $"{value.TotalMinutes:0.#}m";
        }

        return $"{value.TotalSeconds:0.#}s";
    }

    private static string ShortId(string value)
    {
        return value.Length <= 12 ? value : value[..8];
    }
}
