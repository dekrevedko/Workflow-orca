<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Phase0PackageVersion Condition="'$(Phase0PackageVersion)' == ''">0.0.0-phase0</Phase0PackageVersion>
    <RestoreSources Condition="'$(RestoreSources)' == ''">$(MSBuildThisFileDirectory)..\ProductAuthoring\obj\product-feed</RestoreSources>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)obj\package-cache\$(Phase0PackageVersion)</RestorePackagesPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup><PackageVersion Include="OrcaCore" Version="$(Phase0PackageVersion)" /><PackageReference Include="OrcaCore" /></ItemGroup>
  <ItemGroup><Compile Include="../ForbiddenAuthoring/Forbidden.cs" Link="Forbidden.cs" /></ItemGroup>
</Project>
